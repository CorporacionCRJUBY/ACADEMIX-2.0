NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=academix
DB_PASSWORD=change_me
DB_NAME=academix

# Obligatorios en producción (NODE_ENV=production): el server no arranca si
# faltan (ver src/config/env.js). No usar los valores de ejemplo de este
# archivo ni los defaults de dev definidos en env.js — son públicos.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# Límite de tamaño para bodies JSON/urlencoded (auditoria hallazgo bajo #1).
# 2mb alcanza para cualquier request legítima de esta API; los uploads de
# archivos no pasan por aquí (ver UPLOAD_MAX_SIZE_MB, van por multipart).
JSON_BODY_LIMIT=2mb
