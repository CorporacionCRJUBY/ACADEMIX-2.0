NODE_ENV=development
PORT=5000

# El usuario ADMIN se crea con privilegios limitados a academix_v2 usando
# database/setup-mysql.sql (ejecutar como root de MySQL). El password real
# va SOLO en backend/.env (gitignored) — nunca en este archivo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ADMIN
DB_PASSWORD=change_me
DB_NAME=academix_v2

# Obligatorios en producción (NODE_ENV=production): el server no arranca si
# faltan (ver src/config/env.js). No usar los valores de ejemplo de este
# archivo ni los defaults de dev definidos en env.js — son públicos.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# Obligatoria en producción: clave maestra para cifrar en reposo datos
# sensibles (secretos TOTP del 2FA). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_to_64_hex_chars

# Retención de activity_logs/audit_logs en días (job diario de limpieza).
# Opcional; por defecto 730 (2 años).
AUDIT_RETENTION_DAYS=730

# Límite de tamaño para bodies JSON/urlencoded (auditoria hallazgo bajo #1).
# 2mb alcanza para cualquier request legítima de esta API; los uploads de
# archivos no pasan por aquí (ver UPLOAD_MAX_SIZE_MB, van por multipart).
JSON_BODY_LIMIT=2mb

# Origen permitido para CORS (el frontend). Si frontend y backend van en
# orígenes distintos en producción HAY que definirla: sin ella el CORS queda
# cerrado y el navegador bloquea todas las llamadas del frontend (ver
# app.js). Ejemplo real: https://app.midominio.com
CORS_ORIGIN=http://localhost:5173

# Solo si el backend corre DETRÁS de un reverse proxy (nginx, Caddy, ALB...):
# 'true', número de saltos ('1') o subnet ('loopback'). Sin esta variable el
# servidor no confía en X-Forwarded-For (correcto si está expuesto directo).
# TRUST_PROXY=1
